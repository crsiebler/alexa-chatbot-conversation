# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# AWS Configuration (for local testing and setup)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Lambda Function Configuration
LAMBDA_FUNCTION_NAME=alexa-chatbot-conversation
LAMBDA_ROLE_ARN=arn:aws:iam::123456789012:role/lambda-alexa-execution-role

# Alexa Skill ID (obtained after creating the skill in Alexa Developer Console)
ALEXA_SKILL_ID=your_skill_id_here
